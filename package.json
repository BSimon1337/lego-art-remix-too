{
  "name": "lego-art-remix-too",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-based LEGO mosaic builder",
  "scripts": {
    "vendor:sync": "node scripts/sync-vendor.cjs",
    "postinstall": "npm run vendor:sync",
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint tests playwright.config.js vite.config.mjs vitest.config.mjs eslint.config.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke.spec.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "vite": "^6.1.1",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "bootstrap": "^4.6.0",
    "cropperjs": "^2.0.0-alpha.2",
    "d3": "^5.16.0",
    "d3-color-difference": "^0.1.3",
    "firebase": "^7.19.0",
    "jquery": "^3.2.1",
    "jspdf": "^1.5.3",
    "popper.js": "^1.16.1"
  }
}
